#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

compose() {
  MSYS_NO_PATHCONV=1 docker compose --env-file .env.example "$@"
}

step() {
  printf '\n[pre-commit] %s\n' "$1"
}

restore_needed=0
restore_runtime() {
  result=$?
  trap - EXIT
  if [ "$restore_needed" -eq 1 ] && [ -f .env ]; then
    step "Khôi phục cấu hình runtime từ .env"
    MSYS_NO_PATHCONV=1 docker compose --env-file .env up -d --no-deps backend frontend || result=1
  fi
  if [ "$result" -eq 0 ]; then
    step "Tất cả kiểm tra đã pass"
  fi
  exit "$result"
}
trap restore_runtime EXIT

step "Kiểm tra diff đã stage và Docker Compose"
git diff --cached --check
git diff --check
compose config --quiet

step "Build image và đồng bộ dependency khi frontend đã dừng"
compose build
restore_needed=1
compose stop frontend
compose run --rm --no-deps frontend npm ci --no-audit --no-fund

step "Kiểm tra hook và khởi động các service"
compose run --rm --no-deps --volume "$(git rev-parse --show-toplevel)/.githooks:/hooks:ro" backend python -m unittest discover -s /hooks/tests -v
compose up -d

step "Kiểm tra lint và format backend"
compose exec -T backend ruff check .
compose exec -T backend ruff format --check .

step "Kiểm tra lint và format frontend"
compose exec -T frontend npm run lint
compose exec -T frontend npm run format:check

step "Kiểm tra migration"
compose exec -T backend alembic upgrade head
compose exec -T backend alembic check

step "Chạy toàn bộ test backend"
compose exec -T backend pytest -q

step "Kiểm tra code Bronze bằng Delta local (không triển khai Databricks)"
docker build -f data/Dockerfile.test -t daln-data-test data
docker run --rm daln-data-test ruff check .
docker run --rm daln-data-test ruff format --check .
docker run --rm daln-data-test pytest -q tests

step "Chạy test frontend"
compose exec -T frontend npm test

step "Build frontend và kiểm tra dependency"
compose exec -T frontend npm run build
compose exec -T frontend npm audit --audit-level=moderate

step "Smoke test các service đang chạy"
compose exec -T backend python -c "import httpx; r = httpx.get('http://127.0.0.1:8000/health'); assert r.status_code == 200 and r.json() == {'status': 'ok'}"
compose exec -T frontend node -e "fetch('http://127.0.0.1:5173/').then(r => { if (!r.ok) process.exit(1) }).catch(() => process.exit(1))"
