FROM eclipse-temurin:17-jre AS java
FROM python:3.12-slim
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
ENV PYSPARK_PYTHON=python
WORKDIR /data
COPY requirements*.txt ./
RUN pip install --no-cache-dir -r requirements-test.txt
# Resolve Delta jars at build time so the test run does not depend on Maven access.
RUN python -c "from delta import configure_spark_with_delta_pip; from pyspark.sql import SparkSession; configure_spark_with_delta_pip(SparkSession.builder.master('local[1]').config('spark.ui.enabled', 'false')).getOrCreate().stop()"
COPY . .
CMD ["pytest", "-q", "tests"]
